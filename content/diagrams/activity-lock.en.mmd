%% title: Concurrent ingestion — defence per event type
flowchart TB
    K[["Kafka messages<br/>retries and reordering mean the same item can arrive twice at once"]]
    subgraph A["Trade · asset · Swap — single-message events"]
        R["Redis SET NX<br/>first one wins"]
        W1["Save to DB<br/>already saved = finish as success"]
        R --> W1
    end
    subgraph B["Warp — request/result may arrive out of order"]
        P["advisory lock<br/>one at a time per item"]
        S["Look up → create if missing, update if present<br/>whichever arrives first is saved first"]
        P --> S
    end
    N["Emit result event → notification · pre-deduction rollback"]
    K --> R
    K --> P
    W1 --> N
    S --> N
    classDef mine fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    class R,W1,P,S,N mine
