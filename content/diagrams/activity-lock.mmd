%% title: 동시 적재 정합성 — 이벤트 종류별 방어
%% title_en: Concurrent ingestion — defence per event type
flowchart TB
    K[["Kafka 메시지<br/>재시도 · 순서 비보장 → 같은 건이 동시에 들어올 수 있음"]]
    subgraph A["거래 · 자산 · Swap — 단건으로 끝나는 이벤트"]
        R["Redis SET NX + TTL<br/>먼저 잡은 쪽만 처리 · 처리 후 해제"]
        W1["DB 쓰기<br/>unique 위반 = 이미 처리됨 → 성공 종료"]
        R --> W1
    end
    subgraph B["Warp — 요청/결과가 뒤집혀 올 수 있는 이벤트"]
        P["트랜잭션 + advisory lock<br/>네임스페이스 키 + 해시 버킷 키"]
        S["선조회 → 없으면 생성 / 있으면 수정<br/>먼저 온 쪽을 PENDING · NO_CONTENT 로 선행 적재<br/>(nullable 스키마)"]
        P --> S
    end
    N["결과 이벤트 발행 → 알림 · 선차감 롤백"]
    K --> R
    K --> P
    W1 --> N
    S --> N
