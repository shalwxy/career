%% title: CI/CD — per-environment flow (★ = config I added or maintained)
flowchart TB
    subgraph CI["CI — GitLab CI"]
        direction LR
        BR["branch push<br/>develop · test · qa · stage · live"]
        T["test"]
        B["build<br/>build and push Docker image"]
        REL["release<br/>qa · live branches only"]
        BR --> T --> B --> REL
    end
    subgraph REG["Image registries"]
        direction LR
        R1[("GitLab Registry<br/>dev")]
        R2[("AWS ECR<br/>test · qa · stage · live")]
    end
    subgraph CD["CD — deployment · differs per environment"]
        direction LR
        subgraph DEVL["dev — CI deploys directly"]
            direction TB
            D1["CI deploy job<br/>restarts via K8s API"]
            H["Helm templates ★<br/>for the new service"]
            K1["EKS dev"]
            D1 --> K1
            H -.-> K1
        end
        subgraph TQS["test · qa · stage — CI → Rundeck"]
            direction TB
            D2["CI deploy job<br/>calls Rundeck"]
            RD["Rundeck job<br/>applies manifests"]
            M["Per-environment manifests ★<br/>Deployment · HPA · Service"]
            K2["EKS test / qa / stage"]
            D2 --> RD --> M --> K2
        end
        subgraph LIVE["live — outside CI"]
            direction TB
            RL["Rundeck job run manually<br/>(no deploy job in CI)"]
            ML["live manifests ★"]
            K3["EKS live"]
            RL --> ML --> K3
        end
    end
    B -- develop --> R1
    B -- "test · qa · stage · live" --> R2
    R1 --> D1
    R2 -- "test · qa · stage" --> D2
    R2 -- live --> RL
    classDef mine fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    class H,M,ML mine
    style CI fill:#fefce8,stroke:#ca8a04,stroke-width:2px
    style CD fill:#ecfdf5,stroke:#059669,stroke-width:2px
    style REG fill:#f8fafc,stroke:#94a3b8
